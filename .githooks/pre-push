#!/bin/sh
# pre-push hook: main changes only through a merged pull request, and published
# history is never rewritten (CLAUDE.md, "Branches and pull requests").
#
# Refuses, for any remote:
#   - a push that creates, updates or deletes the branch `main`;
#   - a push that would not fast-forward the remote branch (a force push or a
#     rebase of pushed commits), since other people pull these branches.
#
# GitHub's branch rules enforce the main rule server-side as well; this hook
# catches it locally, with a message that says what to do instead.
# Enabled per clone by `git config core.hooksPath .githooks` (Claude Code
# sessions do it automatically via .claude/hooks/session-git-setup.sh).

zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: refusing to push to main. Push a branch cut from main and open a pull request into it; main changes only by merging one." >&2
    status=1
    continue
  fi

  # Creating or deleting a branch rewrites nothing.
  if [ "$local_sha" = "$zero" ] || [ "$remote_sha" = "$zero" ]; then
    continue
  fi

  if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    echo "pre-push: $remote_ref has commits this clone has not fetched. Fetch and merge them first rather than overwriting them." >&2
    status=1
  elif ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    echo "pre-push: pushing to $remote_ref would not fast-forward; it would discard published commits. Merge the remote branch in instead of force-pushing." >&2
    status=1
  fi
done

exit $status
